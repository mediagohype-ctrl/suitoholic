{
  "name": "suitoholic-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "clean": "node -e \"try{fs.rmSync('.next',{recursive:true,force:true})}catch{}\"",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint",
    "dev:api": "npm --prefix server run dev",
    "db:local": "npm --prefix server run db:local",
    "setup:api": "npm --prefix server install",
    "test:api": "npm --prefix server run test:api",
    "test:e2e": "node scripts/e2e.mjs",
    "test:cleanup": "npm --prefix server run test:cleanup"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
