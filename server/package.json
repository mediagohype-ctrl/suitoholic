{
  "name": "suitoholic-server",
  "version": "1.0.0",
  "private": true,
  "description": "Suitoholic Express.js API: catalog, CMS content, bag/cart, orders and admin dashboard backend",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/seed/run.js",
    "seed:reset": "node src/seed/run.js --reset",
    "db:local": "node -e \"require('fs').mkdirSync('.data',{recursive:true})\" && pglite-server --db=.data/pglite --port=54329 --max-connections=1",
    "test:api": "node scripts/smoke-test.js",
    "test:cleanup": "node scripts/cleanup-test-data.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
