# ---------------------------------------------------------------- server
PORT=4000
NODE_ENV=development
# Public URL of this API (used to build image URLs for uploaded media)
PUBLIC_URL=http://localhost:4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------------------------- database
# Neon connection string (Dashboard -> Connection Details). Use the pooled
# connection string ("-pooler" in the host) for production.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Optional: run against a local PGlite database instead (start it with `npm run db:local`)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
# DB_POOL_MAX=1
# DB_SSL=false

# Apply SQL migrations and seed the catalog/admin automatically on start
AUTO_MIGRATE=true
AUTO_SEED=true

# ------------------------------------------------------------------ auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin account (created only when no admin users exist)
ADMIN_NAME=Suitoholic Admin
ADMIN_EMAIL=admin@suitoholic.com
ADMIN_PASSWORD=change-this-password

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_MB=8
